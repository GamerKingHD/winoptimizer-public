{
  "name": "winoptimizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=10.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "cmd /c .\\build.bat",
    "build:release": "cmd /c .\\build.bat --release",
    "build:frontend": "vite build --outDir .build/frontend",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:public": "node scripts/audit-public-boundary.mjs",
    "verify:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-public.ps1"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "diff": "8.0.3",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "serialize-javascript": "7.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "chai": "^6.2.2",
    "happy-dom": "^20.10.2",
    "lightningcss": "^1.32.0",
    "mocha": "^11.7.6",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
